{
  "id": "bpm-default",
  "realm": "bpm-default",
  "enabled": true,
  "displayName": "BPM Default Realm",
  "attributes": {
    "seedVersion": "2026-05-28",
    "tenant_id": "00000000-0000-0000-0000-000000000000"
  },
  "roles": {
    "realm": [
      {
        "name": "PLATFORM_ADMIN"
      },
      {
        "name": "PROCESS_DESIGNER"
      },
      {
        "name": "TASK_WORKER"
      },
      {
        "name": "AGENT_RUNNER"
      }
    ]
  },
  "clients": [
    {
      "clientId": "bpm-platform-api",
      "name": "BPM Platform API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "bpm-platform-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "agent-architect",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "agent-architect-secret"
    },
    {
      "clientId": "agent-developer",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "agent-developer-secret"
    },
    {
      "clientId": "agent-devops",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "agent-devops-secret"
    }
  ],
  "users": [
    {
      "username": "admin-user",
      "email": "admin@bpm.local",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "admin-pass",
          "temporary": false
        }
      ],
      "realmRoles": [
        "PLATFORM_ADMIN"
      ]
    },
    {
      "username": "designer-user",
      "email": "designer@bpm.local",
      "firstName": "Designer",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "designer-pass",
          "temporary": false
        }
      ],
      "realmRoles": [
        "PROCESS_DESIGNER"
      ]
    },
    {
      "username": "worker-user",
      "email": "worker@bpm.local",
      "firstName": "Worker",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "worker-pass",
          "temporary": false
        }
      ],
      "realmRoles": [
        "TASK_WORKER"
      ]
    },
    {
      "username": "operator-user",
      "email": "operator@bpm.local",
      "firstName": "Operator",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "operator-pass",
          "temporary": false
        }
      ],
