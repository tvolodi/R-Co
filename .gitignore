# ── Zig ──────────────────────────────────────────────────────────────────────
.zig-cache/
zig-out/
zig-pkg/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc

# ── Node / Vite (web/) ───────────────────────────────────────────────────────
web/node_modules/
web/dist/
web/.vite/

# ── Environment ──────────────────────────────────────────────────────────────
.env
*.env
.env.*
!.env.example

# ── Secrets (never commit — see SECURITY.md) ─────────────────────────────────
# Note: .gitignore does not untrack files already committed. If one of these
# lands in a commit, `git rm --cached` it before pushing.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
credentials.json
service-account*.json
*-secrets.yaml
*-secrets.yml

# ── Docker volumes & generated files ─────────────────────────────────────────
postgres-data/
docker-compose.override.yml

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor ───────────────────────────────────────────────────────────────────
*.swp
*.swo

# ── Scratch (one-off scripts, debug dumps, temp outputs) ─────────────────────
scratch/

# ── Test artifacts (generated) ───────────────────────────────────────────────
playwright-report/
test-results/
tests/reports/
screenshots/
**/screenshots/
*-screenshot.png
*-screenshot.jpg
*-screenshot.jpeg


