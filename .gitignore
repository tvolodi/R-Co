# ── Zig ──────────────────────────────────────────────────────────────────────
.zig-cache/
zig-out/
zig-pkg/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc

# ── Node / Vite (web/) ───────────────────────────────────────────────────────
web/node_modules/
web/dist/
web/.vite/

# ── Environment ──────────────────────────────────────────────────────────────
.env
*.env
.env.*
!.env.example

# ── Secrets (never commit — see SECURITY.md) ─────────────────────────────────
# Note: .gitignore does not untrack files already committed. If one of these
# lands in a commit, `git rm --cached` it before pushing.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
credentials.json
service-account*.json
*-secrets.yaml
*-secrets.yml

# ── Docker volumes & generated files ─────────────────────────────────────────
postgres-data/
docker-compose.override.yml

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor ───────────────────────────────────────────────────────────────────
*.swp
*.swo

# ── Scratch (one-off scripts, debug dumps, temp outputs) ─────────────────────
scratch/

# ── Queue transient mutex (never commit — held only milliseconds) ─────────────
handoffs/global_queue.lock
# ── Loop stop flag ────────────────────────────────────────────────────────────
handoffs/STOP_LOOP

# ── TaskManager per-workspace claim file — local only, never shared/committed ─
# (the coordination DB itself lives outside this repo entirely, see
#  docs/agents/protocols/LOOP_PROTOCOL.md)
task/current.json

# ── Python virtualenv (local tooling: psycopg2-binary, PyYAML) ───────────────
.venv/
__pycache__/
*.pyc

# ── Local workspace notes (parallel-checkout port map; machine-specific) ─────
WORKSPACE.md

# ── Test artifacts (generated) ───────────────────────────────────────────────
playwright-report/
test-results/
tests/reports/
screenshots/
**/screenshots/
*-screenshot.png
*-screenshot.jpg
*-screenshot.jpeg



# ISS-0161: LuaJIT build artefacts. The bootstrap generates these into the
# source tree when built by the upstream Makefile; build.zig writes them to the
# cache instead, so any copy here is stray.
vendor/luajit/src/*.o
vendor/luajit/src/*.obj
vendor/luajit/src/*.a
vendor/luajit/src/*.lib
vendor/luajit/src/host/*.o
vendor/luajit/src/host/*.exe
vendor/luajit/src/luajit.h
vendor/luajit/src/lj_bcdef.h
vendor/luajit/src/lj_ffdef.h
vendor/luajit/src/lj_libdef.h
vendor/luajit/src/lj_recdef.h
vendor/luajit/src/lj_folddef.h
vendor/luajit/src/jit/vmdef.lua
