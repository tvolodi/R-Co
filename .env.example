# BPM Platform — Environment Variables
# Copy this file to .env and set values for your environment.
# NEVER commit .env to version control.

# -----------------------------------------------------------------------------
# DATABASE (Required for server and migrations)
# -----------------------------------------------------------------------------

# PostgreSQL connection URL for the main development database.
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
BPM_DB_URL=postgres://bpm:bpm@localhost:5432/bpm_dev

# PostgreSQL connection URL used exclusively by integration tests.
# Maps to db_test service (port 5433) in docker-compose.yml.
BPM_TEST_DB_URL=postgres://bpm:bpm@localhost:5433/bpm_test

# -----------------------------------------------------------------------------
# SERVER (Optional — defaults shown)
# -----------------------------------------------------------------------------

# TCP port the HTTP server listens on.
BPM_PORT=8080

# Log verbosity level. Accepted values: DEBUG, INFO, WARN, ERROR.
BPM_LOG_LEVEL=INFO

# Runtime environment tag. Controls certain behaviours (e.g. pretty logs).
# Accepted values: development, staging, production.
BPM_ENV=development

# -----------------------------------------------------------------------------
# SECURITY (Development only — use a strong random value in production)
# -----------------------------------------------------------------------------

# Bootstrap admin token used for initial setup only.
# Set to any non-empty string in development; rotate immediately in production.
BPM_BOOTSTRAP_TOKEN=change-me-in-production
