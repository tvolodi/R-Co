# BPM Platform — Environment Variables
# Copy this file to .env and set values for your environment.
# NEVER commit .env to version control.

# -----------------------------------------------------------------------------
# DATABASE (Required for server and migrations)
# -----------------------------------------------------------------------------

# PostgreSQL connection URL for the main development database.
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
BPM_DB_URL=postgres://bpm:bpm@localhost:5432/bpm_dev

# PostgreSQL connection URL used exclusively by integration tests.
# Maps to db_test service (port 5433) in docker-compose.yml.
BPM_TEST_DB_URL=postgres://bpm:bpm@localhost:5433/bpm_test

# -----------------------------------------------------------------------------
# SERVER (Optional — defaults shown)
# -----------------------------------------------------------------------------

# TCP port the HTTP server listens on.
BPM_PORT=8080

# Log verbosity level. Accepted values: DEBUG, INFO, WARN, ERROR.
BPM_LOG_LEVEL=INFO

# Runtime environment tag. Controls certain behaviours (e.g. pretty logs).
# Accepted values: development, staging, production.
BPM_ENV=development

# -----------------------------------------------------------------------------
# SECURITY (Development only — use a strong random value in production)
# -----------------------------------------------------------------------------

# Bootstrap admin token used for initial setup only.
# Set to any non-empty string in development; rotate immediately in production.
BPM_BOOTSTRAP_TOKEN=change-me-in-production

# -----------------------------------------------------------------------------
# IDENTITY PROVIDER / KEYCLOAK (Required for server — src/config/identity_provider.zig)
# -----------------------------------------------------------------------------
# docker-compose.yml runs Keycloak behind an nginx gateway on host port 8081
# (container keycloak:8080 -> host keycloak_gateway:8081). All BPM_IDP_* values
# below configure src/config/identity_provider.zig's loadFromProcessEnv(), which
# is called at server startup. If a "Required" variable is unset or empty, the
# server fails to start immediately with a ConfigLoadError (MissingProviderType /
# MissingBaseUrl / MissingAdminCredentialsRef / MissingDefaultRealmOrTenant).

# Identity provider backend. Accepted values: keycloak, stub.
# Required — server fails to start if unset (error.MissingProviderType).
BPM_IDP_PROVIDER_TYPE=keycloak

# Base URL of the identity provider, reachable from the backend process.
# Required — server fails to start if unset (error.MissingBaseUrl).
BPM_IDP_BASE_URL=http://localhost:8081

# Reference to where the admin/client secret is stored (not the secret itself).
# Format: env:<VAR_NAME> — the named var (BPM_KEYCLOAK_SECRET below) is read at
# runtime. Required — server fails to start if unset (error.MissingAdminCredentialsRef).
BPM_IDP_ADMIN_CREDENTIALS_REF=env:BPM_KEYCLOAK_SECRET

# The actual Keycloak admin/client secret, resolved at runtime by
# src/identity/provider/bootstrap.zig from the "env:BPM_KEYCLOAK_SECRET"
# reference above. Matches KEYCLOAK_ADMIN_PASSWORD in docker-compose.yml
# for local development.
BPM_KEYCLOAK_SECRET=admin

# Default Keycloak realm (or tenant slug) the platform operates against.
# Must match a realm imported from infrastructure/keycloak/realms/ (bpm-default.json).
# Required — server fails to start if unset (error.MissingDefaultRealmOrTenant).
BPM_IDP_DEFAULT_REALM_OR_TENANT=bpm-default

# Optional overrides — omit to use loadIdentityProviderConfig()'s built-in defaults.
# BPM_IDP_ADMIN_REALM=bpm-default
# BPM_IDP_EXPECTED_AUDIENCE=bpm-platform-api
# BPM_IDP_EXPECTED_ISSUER=http://localhost:8081/realms/bpm-default
# BPM_IDP_REQUEST_TIMEOUT_MS=5000
# BPM_IDP_CONNECT_TIMEOUT_MS=1000

# -----------------------------------------------------------------------------
# FRONTEND E2E / UAT (Required for Playwright E2E tests and the UAT-RUNNER agent)
# -----------------------------------------------------------------------------

# Base URL of the running BPM API server, used by UAT-RUNNER's curl-based
# evidence collection (docs/agents/functions/fn-run-uat-scenarios.md) and by
# CLAUDE.md's UAT-RUNNER agent section. If unset, those curl calls fail with
# an empty/invalid URL — there is no default.
BPM_API_URL=http://localhost:8080

# Bearer token used by UAT-RUNNER to authenticate against BPM_API_URL when
# fetching instance state and audit evidence. If unset, curl calls send an
# empty Authorization header and the API returns 401.
BPM_UAT_TOKEN=

# Keycloak test-account credentials used by Playwright E2E specs
# (web/tests/e2e/*.e2e.spec.ts) for admin-role login flows.
# If unset, most specs fall back to admin-user/admin-pass (the seeded
# bpm-default realm account); a few specs (env04, tenants) treat these as
# required and fail fast with an explicit error if unset.
BPM_E2E_ADMIN_USERNAME=admin-user
BPM_E2E_ADMIN_PASSWORD=admin-pass

# -----------------------------------------------------------------------------
# ORCH LOOP MODE (Required if this checkout will ever run "start loop" /
# process the GitHub issue queue via tools/gh_claim.py)
# -----------------------------------------------------------------------------

# Unique ID for THIS checkout, used as <workspace_id> when claiming/releasing
# GitHub issue locks (handoffs/global_queue.json). MUST be distinct across
# every parallel workspace on the same host: $env:COMPUTERNAME alone is NOT
# enough, because two checkouts on one machine share the same COMPUTERNAME,
# which lets two workspaces' locks collide under the identical key and both
# claim the same issue (see docs/anti-patterns.md, 2026-08-07 GH-542
# incident). If you have COMPOSE_PROJECT_NAME set for parallel-workspace
# port isolation, reuse that value here rather than inventing a new one.
BPM_WORKSPACE_ID=r-co-loop
